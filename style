* {
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}
html{
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  color: rgb(231, 217, 217);
}
body{

  background-color: rgb(126, 125, 125);
}

.main {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.view1{
  width: 100%;
  background-color: black;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.top{
  height: 100%;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 50px;
}
  
    img{
      object-fit: cover;
      width: 50%;
      height: 100%;
      border-radius: 50px;
    
      padding: 5vw 4vh;
    }
    .bottom{
      display: flex;
      flex-direction: row-reverse;
      background-color: rgb(60, 58, 58);
      padding: 5vw 4vh;
      width: 50%;
      height: 80%;
      border-radius: 50px;

    }
      h2{
        padding-top: 10px;
    
        }
      .text h1{
          padding-top: 10vw;
              font-size: 4rem;
      }
      .text p{
        opacity: 0.5;
        padding-top: 2vh
                     
      }
          h6{
            background-color: transparent;
            padding-top: 100px;
          }
          

      
    


